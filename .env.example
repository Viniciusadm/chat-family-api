# ---- Obrigatórias (o servidor não sobe sem elas) ----
DATABASE_URL=mysql://root:root@localhost:3306/chat_back
# Gere um valor privado com no mínimo 32 caracteres, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=

# ---- Servidor ----
# Use 0.0.0.0:3000 when testing from a physical device on the same network.
BIND_ADDR=127.0.0.1:3000

# ---- Tokens JWT ----
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---- Upload de mídia ----
MEDIA_ROOT=./media
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/static

# ---- CORS (obrigatório para clientes web; clientes nativos não usam) ----
# Lista separada por vírgula, ex.: https://app.exemplo.com,http://localhost:8081
ALLOWED_ORIGINS=

# ---- Rate limiting (deixe vazio para desabilitar — sem Redis não há proteção
#      contra força bruta em /auth/login e /auth/child-login) ----
REDIS_URL=

# ---- Push notifications (opcional) ----
EXPO_ACCESS_TOKEN=

# ---- Rate limiting do child-login ----
CHILD_LOGIN_MAX_ATTEMPTS=5
CHILD_LOGIN_WINDOW_SECS=60
